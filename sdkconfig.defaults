CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16MiB.csv"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MAIL_DTU_TX_GPIO=17
CONFIG_MAIL_DTU_RX_GPIO=18

# MPU6050 fall detection; DTU remains on GPIO17/18.
CONFIG_FALL_IMU_I2C_PORT=0
CONFIG_FALL_IMU_SDA_GPIO=4
CONFIG_FALL_IMU_SCL_GPIO=5
CONFIG_FALL_IMU_I2C_HZ=400000
CONFIG_FALL_IMU_ADDR_8BIT=0xD0
CONFIG_FALL_IMU_ODR_HZ=125
CONFIG_FALL_IMU_PERIOD_MS=8
CONFIG_FALL_REFRACTORY_MS=5000
