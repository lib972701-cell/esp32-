CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16MiB.csv"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MAIL_DTU_TX_GPIO=17
CONFIG_MAIL_DTU_RX_GPIO=18

# MPU6050 fall detection; DTU remains on GPIO17/18.
CONFIG_FALL_IMU_I2C_PORT=0
CONFIG_FALL_IMU_SDA_GPIO=4
CONFIG_FALL_IMU_SCL_GPIO=5
CONFIG_FALL_IMU_I2C_HZ=400000
CONFIG_FALL_IMU_ADDR_8BIT=0xD0
CONFIG_FALL_IMU_ODR_HZ=125
CONFIG_FALL_IMU_PERIOD_MS=8
CONFIG_FALL_REFRACTORY_MS=5000

CONFIG_CLOUD_AI_ENABLE=y
CONFIG_FALL_IMU_I2C_PORT=1
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
# CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE is not set
CONFIG_CODEC_ES8388_SUPPORT=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048
CONFIG_OTA_URL="https://api.tenclass.net/xiaozhi/ota/"

# DNESP32S3 V1.0: 8MB Octal PSRAM; audio and TLS need external heap.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# External MaixCAM2 UART2: wiring is not confirmed yet.
CONFIG_VISION_UART_ENABLE=y
CONFIG_VISION_TX_GPIO=6
CONFIG_VISION_RX_GPIO=16
